@model NutriBem.Models.AgendamentoCreateDto

<div>
    @if (TempData["MensagemSucesso"] != null)
    {
        <div style="background: green; color: white; padding: 10px;">@TempData["MensagemSucesso"]</div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div style="background: red; color: white; padding: 10px;">@TempData["MensagemErro"]</div>
    }

    <h3>Olá, @ViewBag.NomePaciente! Vamos agendar seu atendimento:</h3>

    <form method="post" action="/Agendamento">
        @Html.AntiForgeryToken()

        <div style="margin-bottom: 15px;">
            <label>Data do agendamento:</label>
            <input type="date" name="data_agendamento" required style="width: 100%; padding: 10px;">
        </div>

        <div style="margin-bottom: 15px;">
            <label>Horário do agendamento:</label>
            <input type="time" name="horario_agendamento" required style="width: 100%; padding: 10px;">
        </div>

        <button type="submit" style="width: 100%; padding: 12px; background: blue; color: white; border: none;">
            Agendar
        </button>
    </form>
</div>
